{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "harish-portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/harish-portfolio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{"glob":"**/*","input":"public"}]
          },
          "configurations": {
            "production": {"budgets":[{"type":"initial","maximumWarning":"600kB","maximumError":"1MB"},{"type":"anyComponentStyle","maximumWarning":"8kB","maximumError":"12kB"}],"outputHashing":"all","optimization":{"fonts":{"inline":false}}},
            "development": {"optimization":false,"extractLicenses":false,"sourceMap":true}
          },
          "defaultConfiguration":"production"
        },
        "serve": {"builder":"@angular/build:dev-server","configurations":{"production":{"buildTarget":"harish-portfolio:build:production"},"development":{"buildTarget":"harish-portfolio:build:development"}},"defaultConfiguration":"development"}
      }
    }
  }
}
